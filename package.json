{
  "name": "cykla",
  "version": "0.1.0",
  "private": true,
  "description": "Offline-first cycle and period tracker built with Expo, React Native and SQLite.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Luis-0508/Cykla.git"
  },
  "bugs": "https://github.com/Luis-0508/Cykla/issues",
  "engines": {
    "node": ">=24.12.0 <25"
  },
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "node scripts/start-web.mjs",
    "web:metro": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "doctor": "expo-doctor",
    "build:smoke": "expo export --platform all"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@hookform/resolvers": "^5.9.1",
    "@tanstack/react-query": "^5.104.1",
    "expo": "~58.0.3",
    "expo-constants": "~58.0.9",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-linking": "~58.0.10",
    "expo-local-authentication": "~57.0.3",
    "expo-localization": "~57.0.2",
    "expo-notifications": "~58.1.0",
    "expo-router": "~58.0.13",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.22",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "~58.0.9",
    "expo-status-bar": "~57.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.89.0",
    "react-native": "0.87.1",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.28.0",
    "react-native-web": "~0.21.3",
    "react-native-worklets": "0.13.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "@types/react-test-renderer": "19.3.0",
    "@vitest/coverage-v8": "4.1.11",
    "babel-preset-expo": "~58.0.9",
    "eslint": "^9.39.2",
    "eslint-config-expo": "~57.0.2",
    "expo-doctor": "1.20.4",
    "prettier": "^3.9.9",
    "react-test-renderer": "19.3.0",
    "typescript": "~6.0.3",
    "vitest": "4.1.11"
  },
  "license": "AGPL-3.0-only",
  "overrides": {
    "@expo/metro-config": {
      "postcss": "^8.5.28"
    }
  }
}
